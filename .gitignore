# =====================================================================
#  GitHub 업로드 제외 목록
#  (GitHub Pages 는 main 브랜치의 /docs 폴더를 배포합니다)
# =====================================================================

# --- PowerPoint 원본 ---------------------------------------------------
# 수업 원본 PPT 는 저장소에 올리지 않습니다.
# 학생에게는 docs/lessons/*/slides/ 의 이미지와 slides.pdf 로 제공합니다.
*.ppt
*.pptx
~$*.ppt
~$*.pptx

# --- 원본 PDF ----------------------------------------------------------
# 최상위의 커리큘럼 PDF 등 원본 문서는 저장소에 올리지 않습니다.
# (파일은 그대로 두고, GitHub 업로드에서만 제외합니다)
*.pdf

# 단, 웹사이트가 실제로 사용하는 교안 PDF 는 배포해야 하므로 되살립니다.
# 이 줄이 없으면 강의자료 페이지의 "PDF 다운로드" 버튼이 404 가 됩니다.
!docs/lessons/*/slides.pdf

# --- PowerPoint 자동 저장 · 임시 · 복구 파일 ---------------------------
*.tmp
*.temp
*.asd
*.wbk
~$*

# --- PPT -> PNG 중간 변환 결과 -----------------------------------------
# tools/export-slides.ps1 로 언제든 다시 만들 수 있으므로 올리지 않습니다.
tools/_png/
tools/_work/

# --- 운영체제 파일 -----------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# --- 개발 의존성과 캐시 -------------------------------------------------
node_modules/
.vscode/
.idea/
__pycache__/
*.pyc

# =====================================================================
#  주의 — 아래 파일들은 배포에 꼭 필요하므로 제외하지 않습니다.
#    docs/lessons/*/slides/*.webp   슬라이드 이미지
#    docs/lessons/*/thumbs/*.webp   썸네일
#    docs/lessons/*/slides.pdf      학생 다운로드용 교안 PDF
#    docs/PRD/**                    PRD 기획 페이지 배포본
# =====================================================================

# --- 예전 버전 보관함 (로컬에만 둠) ---------------------------------
_보관/

# 학생 작품 — 실명이 들어 있어 공개 저장소에 올리지 않습니다.
# 수업에서는 로컬에서 docs/students/index.html 로 열어 보여 줍니다.
# 나눠 줄 때는  python tools/build-offline.py  로 만든 한 파일(학생작품_모아보기.html)을 씁니다.
docs/students/
/학생작품_모아보기*.html
/강의홈페이지_모아보기*.html

# 이름을 가린 공개용 사본 (tools/build-gallery.py 로 만듭니다 — 지금은 쓰지 않습니다)
docs/gallery/

# 공개용 번호 ↔ 실명 대조표 (선생님 노트북에만 둡니다)
tools/_private/
